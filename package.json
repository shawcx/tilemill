{
    "name": "tilemill",
    "version": "1.2.0",
    "main": "./index.js",
    "description": "A modern map design studio.",
    "keywords": [
        "map",
        "design",
        "cartography"
    ],
    "url": "https://github.com/tilemill-project/tilemill",
    "repository": {
        "type": "git",
        "url": "https://github.com/tilemill-project/tilemill.git"
    },
    "contributors": [
        "Cory Sytsma <csytsma>",
        "Tom MacWright <tmcw>",
        "Konstantin Kaefer <kkaefer>",
        "Will White <willwhite>",
        "Dane Springmeyer <springmeyer>",
        "Dmitri Gaskin <dmitrig01>",
        "AJ Ashton <ajashton>",
        "Tristen Brown <tristen>",
        "Young Hahn <yhahn>",
        "Ansis Brammanis <aibram>",
        "Justin Miller <incanus>"
    ],
    "licenses": [
        {
            "type": "BSD"
        }
    ],
    "dependencies": {
        "JSV": "4.0.2",
        "backbone-dirty": "1.1.3",
        "bones": "1.3.30",
        "carto": "1.2.0",
        "chrono": "1.0.5",
        "glob": "7.1.3",
        "jquery": "3.7.1",
        "mapnik": "npm:@mapnik/mapnik@4.8.2",
        "@mapbox/mbtiles": "0.12.1",
        "millstone": "0.6.18",
        "modestmaps": "3.3.5",
        "sax": "1.2.4",
        "semver": "5.7.2",
        "@mapbox/sphericalmercator": "1.1.0",
        "sqlite3": "6.0.1",
        "step": "1.0.0",
        "@mapbox/tilelive-mapnik": "1.0.0",
        "underscore": "1.13.8",
        "wax": "https://github.com/tilemill-project/wax.git#v6.4.4",
        "tilelive": "5.14.0",
        "js-yaml": "^4.1.0"
    },
    "devDependencies": {
        "mocha": "^12.0.3",
        "difflet": "1.0.1"
    },
    "scripts": {
        "start": "./index.js",
        "test": "mocha --timeout 100000",
        "postinstall": "node ./lib/gitutil.js",
        "debug-test": "mocha --inspect-brk --timeout 100000"
    },
    "bin": {
        "tilemill": "./index.js"
    },
    "engineStrict": true,
    "engines": {
        "node": ">=22"
    },
    "overrides": {
        "mapnik": "$mapnik",
        "sqlite3": "$sqlite3",
        "@mapbox/tilelive-mapnik": {
            "mime": "1.6.0"
        },
        "tar": "^7.5.22",
        "lodash": "^4.18.1",
        "backbone-dirty": {
            "underscore": "1.13.8"
        }
    },
    "workspaces": [
        "vendor/*"
    ],
    "allowScripts": {
        "gdal-async@3.12.3": true,
        "@mapnik/mapnik@4.8.2": true,
        "sqlite3@6.0.1": true
    }
}
